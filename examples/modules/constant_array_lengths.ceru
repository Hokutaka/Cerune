import "dimensions.ceru" as dimensions;

print("共有サイズ");
rows: [dimensions::Row; dimensions::ROWS] = [
    dimensions::FIRST,
    dimensions::Row { values: [4, 5, 6] },
];
for (row: infer in rows) {
    // リテラルの長さと定数の長さは、確定した値が同じなら同じ配列型です。
    values: [i64; dimensions::WIDTH] = row.values;
    print(dimensions::total(values));
}
print("保持\0\r\n");
