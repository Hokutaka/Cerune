fn value(label: string, number: f64) -> f64 { print(label); return number; }
fn pair(left: i64, right: i64) -> i64 { return left + right; }
print("評価順");
print(pair(floor<i64>(value("左", 3.7)), ceil<i64>(value("右", -1.9))));
print(false && round<u8>(value("呼ばれない", 255.5)) == 0);
print(true || floor<u8>(value("呼ばれない", -0.1)) == 0);
mut colors: [u8; 2] = [saturating_round<u8>(300.0), round_ties_even<u8>(2.5)];
saved: infer = colors;
colors[0] = saturating_floor<u8>(value("更新", -0.1));
print(saved[0]); print(colors[0]); print(saved[1]);
