// 固定長の座標ペアを動的配列に入れ、コピーだけを平行移動します。
fn translate(points: [[f64; 2]], dx: f64, dy: f64) -> [[f64; 2]] {
    mut result: [[f64; 2]] = points;
    mut i: i64 = 0;
    while i < array_len(result) {
        result[i][0] = result[i][0] + dx;
        result[i][1] = result[i][1] + dy;
        i = i + 1;
    }
    return result;
}

original: [[f64; 2]] = array_copy([[1.0, 2.0], [3.0, 4.0]]);
mut moved: [[f64; 2]] = translate(original, 10.0, -1.0);
saved: [[f64; 2]] = moved;
moved[0][0] = 99.0;
print(original);
print(saved);
print(moved);
print(original == saved);
