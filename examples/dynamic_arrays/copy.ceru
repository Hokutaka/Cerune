// 動的配列の作成、独立コピー、範囲コピー。IR Executor・VM・C・LLVMで実行できます。
mut values: [i64] = array_copy([10, 20, 30]);
saved: [i64] = values;
part: [i64] = array_copy_range(values, 1, 3);
values[1] = 99;
print(values); // [10, 99, 30]
print(saved);  // [10, 20, 30]
print(part);   // [20, 30]
print(array_len(part)); // 2
empty: [i64] = array_copy_range(values, 3, 3);
print(empty); // []
print(saved == values); // false
for (item: i64 in part) { print(item); } // 20, 30
