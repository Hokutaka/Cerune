// run（run-ir）で直接実行し、run-vm と比較、emit-ir で処理を確認できます。
// Run with run (alias run-ir), compare with run-vm, and inspect with emit-ir.
fn greet(name: string) -> string {
    return concat("Hello, ", name);
}

fn main() -> void {
    mut names: [string; 2] = ["Cerune", "世界"];
    saved: [string; 2] = names;
    names[0] = "IR";

    for (name: string in names) {
        print(greet(name));
    }
    print(saved);
}
