fn value(label: string, number: f64) -> f64 { print(label); return number; }
fn pair(left: i64, right: i64) -> i64 { return left + right; }
print("評価順");
print(pair(trunc<i64>(value("左", 3.7)), trunc<i64>(value("右", -1.9))));
print(false && trunc<u8>(value("呼ばれない", 256.0)) == 0);
print(true || trunc<u8>(value("呼ばれない", -1.0)) == 0);
mut values: [u8; 2] = [trunc<u8>(255.9), trunc<u8>(-0.9)];
saved: infer = values;
values[0] = trunc<u8>(12.9);
print(saved[0]); print(values[0]); print(saved[1]);
